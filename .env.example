# SiteLens AI Reality Inspector — example environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# This file contains NO real credentials. Every value below is a placeholder
# or a public default.

# --- Provider selection -----------------------------------------------------
# nebius = real path (Nebius Token Factory + a real vision model)
# demo   = deterministic offline provider (no Nebius call, NOT hackathon-eligible)
#
# Precedence: real process environment variables win over this file, so an
# exported NEBIUS_MODEL in your shell overrides the value here. The scripts load
# `.env` with Node's --env-file-if-exists, so this file is read automatically and
# the run still works when `.env` is absent. The server prints the provider AND
# model it actually resolved on startup: check that banner before trusting a run.
AI_PROVIDER=nebius

# --- Nebius Token Factory ---------------------------------------------------
# REQUIRED for AI_PROVIDER=nebius. Without it the inspector fails closed with
# NOT_CONFIGURED and produces NO observations.
#
# Get one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# OpenAI-compatible endpoint. Regional variants exist, e.g.
# https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Vision model served by Token Factory.
#
# Selected by measurement over five real construction photographs at
# NEBIUS_MAX_TOKENS=3000, judged by this repository's own validators:
#
#   model                  usable imgs  elements  findings  avg ms
#   openbmb/MiniCPM-V-4_5        4/5         16        9     6,228
#   google/gemma-3-27b-it       2/5          5        2     5,897
#   Qwen/Qwen3.8-27B            1/5          5        1    12,863
#
# MiniCPM won on inspection yield, not speed. The full server pipeline was then
# validated on 18 real images: 18/18 succeeded, 0 provider failures, ~5.1s mean.
#
# It is NOT an NVIDIA model, and that is deliberate rather than a workaround:
# every nvidia/* id in the catalogue rejects image input, so no NVIDIA model can
# be the vision stage. The NVIDIA requirement is met at stage 2 instead, by
# Nemotron reasoning over this model's output - see NEBIUS_REASONING_MODEL.
# When an NVIDIA VISION model ships, change ONLY this line. No code change.
#
# Qwen3.8-27B is NOT broken: it is a reasoning model that spends 3,000-4,100
# completion tokens on reasoning before answering, so it needs
# NEBIUS_MAX_TOKENS >= 6000 and is ~2x slower.
NEBIUS_MODEL=openbmb/MiniCPM-V-4_5

# Per-call deadline in milliseconds (1000-300000).
NEBIUS_TIMEOUT_MS=60000

# Hard cap on the completion length (256-16000).
# At 1400 MiniCPM truncated mid-JSON on real site photographs and returned
# unparseable output. A token sweep showed 3000 removes that truncation
# (finish_reason becomes `stop`) while staying tight enough that the model does
# not pad its answer. 6000+ is required for reasoning models.
NEBIUS_MAX_TOKENS=3000

# Maximum entries accepted from one model response, per array (1-20).
AI_MAX_OBSERVATIONS=6

# --- Stage 2: construction reasoning (NVIDIA Nemotron) ----------------------
# The vision model sees the photograph. This model does NOT: it receives
# MiniCPM's validated observations plus SiteLens's computed comparison rows and
# reasons about them in text. That split is the hybrid architecture, and this
# stage is where the NVIDIA model actually runs.
#
# All four nvidia/Nemotron-* ids in the catalogue reject IMAGE input, which is
# irrelevant here because this stage wants text. Measured live on this
# project's real reasoning prompt and a real inspection context:
#
#   model                          HTTP  latency  reasoning  schema-valid
#   Nemotron-3-Ultra-550b-a55b      200   3,868ms       713    yes  (default)
#   nemotron-3-super-120b-a12b      200   5,613ms       571    yes
#   NVIDIA-Nemotron-3-Nano-30B-A3B  200   2,859ms         0    yes
#   Nemotron-3_5-Lightning          200  11,366ms      2000    NO - finish_reason=length,
#                                                                spent the budget
#                                                                reasoning, no JSON
#
# Lightning answers HTTP 200 and produces nothing usable, so it is NOT in
# VERIFIED_REASONING_MODELS. Callable is not the same as usable.
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Completion budget for the reasoning stage. Higher than the vision budget on
# purpose: Nemotron spends tokens reasoning BEFORE answering (measured 437-713
# tokens), so a tight budget truncates it mid-JSON and the stage is lost.
NEBIUS_REASONING_MAX_TOKENS=2000

# Reasoner deadline. Slightly longer than vision, because it must think first.
NEBIUS_REASONING_TIMEOUT_MS=90000

# Set to false to switch stage 2 off. The vision observation and the
# deterministic comparison are unaffected, and the UI reports reasoning as
# UNAVAILABLE rather than omitting it.
REASONING_ENABLED=true

# --- Local paths -----------------------------------------------------------
# Where the local validation dataset lives. The directory is read directly; the
# images are never uploaded by this application and are not tracked by git.
# Absent is reported as absent - the product runs fine without it.
SITELENS_DATASET_DIR=sample

# Where durable state is written. Set SITELENS_PERSIST=off to run entirely in
# memory, in which case the API reports `process memory` and durable:false.
SITELENS_DATA_DIR=data
