# SiteLens AI Reality Inspector — example environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# This file contains NO real credentials. Every value below is a placeholder
# or a public default.

# --- Provider selection -----------------------------------------------------
# nebius = real path (Nebius Token Factory + a real vision model)
# demo   = deterministic offline provider (no Nebius call, NOT hackathon-eligible)
#
# Precedence: real process environment variables win over this file, so an
# exported NEBIUS_MODEL in your shell overrides the value here. The scripts load
# `.env` with Node's --env-file-if-exists, so this file is read automatically and
# the run still works when `.env` is absent. The server prints the provider AND
# model it actually resolved on startup: check that banner before trusting a run.
AI_PROVIDER=nebius

# --- Nebius Token Factory ---------------------------------------------------
# REQUIRED for AI_PROVIDER=nebius. Without it the inspector fails closed with
# NOT_CONFIGURED and produces NO observations.
#
# Get one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# OpenAI-compatible endpoint. Regional variants exist, e.g.
# https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Vision model served by Token Factory.
#
# Selected by measurement over five real construction photographs at
# NEBIUS_MAX_TOKENS=3000, judged by this repository's own validators:
#
#   model                  usable imgs  elements  findings  avg ms
#   openbmb/MiniCPM-V-4_5        4/5         16        9     6,228
#   google/gemma-3-27b-it       2/5          5        2     5,897
#   Qwen/Qwen3.8-27B            1/5          5        1    12,863
#
# MiniCPM won on inspection yield, not speed. The full server pipeline was then
# validated on 18 real images: 18/18 succeeded, 0 provider failures, ~5.1s mean.
#
# It is NOT an NVIDIA model. Every nvidia/* id in the catalogue returns
# `HTTP 400 This model does not support image input` (text-only), so the UI
# honestly reports eligibility as NOT_ELIGIBLE. When an NVIDIA vision model
# ships, change ONLY this line. No code change.
#
# Qwen3.8-27B is NOT broken: it is a reasoning model that spends 3,000-4,100
# completion tokens on reasoning before answering, so it needs
# NEBIUS_MAX_TOKENS >= 6000 and is ~2x slower.
NEBIUS_MODEL=openbmb/MiniCPM-V-4_5

# Per-call deadline in milliseconds (1000-300000).
NEBIUS_TIMEOUT_MS=60000

# Hard cap on the completion length (256-16000).
# At 1400 MiniCPM truncated mid-JSON on real site photographs and returned
# unparseable output. A token sweep showed 3000 removes that truncation
# (finish_reason becomes `stop`) while staying tight enough that the model does
# not pad its answer. 6000+ is required for reasoning models.
NEBIUS_MAX_TOKENS=3000

# Maximum entries accepted from one model response, per array (1-20).
AI_MAX_OBSERVATIONS=6