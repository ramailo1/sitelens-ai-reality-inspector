# Secrets — NEVER commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log

# Local scratch
tmp/

# Runtime state written by the local inspection server (SITELENS_DATA_DIR).
# Holds the workspace file, uploaded bytes and per-capture inspection records
# produced by actually running the app. Never source: it is regenerated on every
# run and would otherwise be swept into a commit by `git add -A`.
data/
